# Vikunja インスタンスのベース URL (末尾スラッシュなし、/api/v1 は含めない)
VIKUNJA_BASE_URL=https://vikunja.example.com

# Vikunja の API トークン (Settings > API Tokens で発行)。絶対に公開しないこと。
VIKUNJA_API_TOKEN=

# タスク作成時にデフォルトで使うプロジェクト ID (省略可。ツール呼び出し時に project_id を
# 明示すればこの値は使われない)
VIKUNJA_PROJECT_ID=

# Vikunja API へのリクエストタイムアウト (秒)
VIKUNJA_TIMEOUT_SECONDS=15

# Vikunja サーバーの TLS 証明書を検証するかどうか (自己署名証明書等でオフにする場合のみ false)
VIKUNJA_VERIFY_TLS=true

# エージェント識別用ラベルの接頭辞
VIKUNJA_AGENT_LABEL_PREFIX=agent-

# 状態表現用ラベルの接頭辞 (例: status-running, status-completed)
VIKUNJA_STATUS_LABEL_PREFIX=status-
